# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Neon PostgreSQL connection string (e.g. postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/uniminuto_acceso?sslmode=require"

# BETTER_AUTH_SECRET: Secret key for session tokens and encryption
BETTER_AUTH_SECRET="uniminuto_secure_auth_secret_2026_change_in_production"

# MONGODB_URI: MongoDB Atlas or local MongoDB connection string (e.g. mongodb+srv://user:pass@cluster0.mongodb.net/uniminuto_acceso?retryWrites=true&w=majority)
MONGODB_URI="mongodb://localhost:27017/uniminuto_acceso"
