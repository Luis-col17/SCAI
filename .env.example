# MONGODB: Conexión a MongoDB Atlas
# Formato: mongodb+srv://usuario:password@cluster.mongodb.net/database
MONGODB_URI="mongodb+srv://usuario:password@cluster.mongodb.net/uniminuto_acceso?retryWrites=true&w=majority"
MONGODB_USERNAME="tu_usuario"
MONGODB_PASSWORD="tu_password"

# AUTENTICACIÓN: Claves para JWT y sesiones
# CAMBIAR EN PRODUCCIÓN: generar string aleatorio largo (ej: openssl rand -base64 64)
SESSION_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio_en_produccion"
BETTER_AUTH_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio_en_produccion"

# CLOUDINARY: Almacenamiento de imágenes (avatar, enrolamiento, snapshots)
# Obtener en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# SERVICIO PYTHON IA FACIAL
# URL donde corre el microservicio FastAPI (puerto 8000 por defecto)
FACE_SERVICE_URL="http://127.0.0.1:8000"
# Timeout en ms al llamar a /embed
FACE_SERVICE_TIMEOUT_MS=8000
# Umbral distancia coseno para match (0.3-0.6, menor = más estricto)
FACE_MATCH_THRESHOLD=0.45

